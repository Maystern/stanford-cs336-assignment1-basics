{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PyTest Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Train Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "args": [
                "-t", "./config/train.yaml",
                "-m", "./config/gpt2_tiny.yaml"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
    ]
}