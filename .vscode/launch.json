{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "BPE Tokenizer - PyTest Debugger",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/test_train_bpe.py"],
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
       {
            "name": "BPE Tokenizer - Main Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "cs336_basics/train_bpe.py",
            "args": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Tokenizer - Main Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "cs336_basics/tokenizer.py",
            "args": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Tokenizer - PyTest Debugger",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/test_tokenizer.py"],
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Linear - PyTest Debugger",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-k",
                "test_linear",
                "-v"
            ],
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
    ]
}